(version 1)
# Generated by tools/p4.py from the design spec and tools/p4_rules.json; edit those, not this file.
# KiCad applies the last matching rule, so clearance rules are sorted by increasing value.
(rule "default clearance"
  (constraint clearance (min 0.4mm)))
(rule "track to pad F.Cu" (layer "F.Cu")
  (condition "(A.Type == 'Track' || A.Type == 'Arc') && B.Type == 'Pad'")
  (constraint clearance (min 0.5mm)))
(rule "track to pad B.Cu" (layer "B.Cu")
  (condition "(A.Type == 'Track' || A.Type == 'Arc') && B.Type == 'Pad'")
  (constraint clearance (min 0.6mm)))
(rule "24V_IN to logic signals"
  (condition "A.NetName == '/24V_IN' && B.hasNetclass('Signal')")
  (constraint clearance (min 0.8mm)))
(rule "between isolated outputs"
  (condition "A.hasNetclass('Iso') && B.hasNetclass('Iso') && !(A.memberOfFootprint('K1') && B.memberOfFootprint('K1')) && !(A.memberOfFootprint('K2') && B.memberOfFootprint('K2'))")
  (constraint clearance (min 0.8mm)))
(rule "isolated outputs to other nets"
  (condition "A.hasNetclass('Iso') && !B.hasNetclass('Iso') && !(A.memberOfFootprint('K1') && B.memberOfFootprint('K1')) && !(A.memberOfFootprint('K2') && B.memberOfFootprint('K2')) && !(A.memberOfFootprint('J1') && B.memberOfFootprint('J1'))")
  (constraint clearance (min 3.0mm)))
(rule "board edge"
  (constraint edge_clearance (min 0.6mm)))
(rule "track width"
  (condition "(A.Type == 'Track' || A.Type == 'Arc')")
  (constraint track_width (min 0.4mm)))
(rule "track width Signal"
  (condition "(A.Type == 'Track' || A.Type == 'Arc') && A.hasNetclass('Signal')")
  (constraint track_width (min 0.4mm)))
(rule "track width Iso"
  (condition "(A.Type == 'Track' || A.Type == 'Arc') && A.hasNetclass('Iso')")
  (constraint track_width (min 0.6mm)))
(rule "track width Power"
  (condition "(A.Type == 'Track' || A.Type == 'Arc') && A.hasNetclass('Power')")
  (constraint track_width (min 0.8mm)))
(rule "via size"
  (condition "A.Type == 'Via'")
  (constraint via_diameter (min 1.2mm) (max 1.2mm)) (constraint hole_size (min 0.6mm) (max 0.6mm)))
(rule "via to pad"
  (condition "A.Type == 'Via' && B.Type == 'Pad'")
  (constraint physical_clearance (min 1.0mm)))
(rule "mounting hole copper-free radius"
  (condition "B.memberOfFootprint('Carrier:Mount_M3')")
  (constraint hole_clearance (min 2.4mm)))
(rule "silk text F.SilkS" (layer "F.SilkS")
  (constraint text_height (min 1.2mm)) (constraint text_thickness (min 0.15mm)))
(rule "silk text B.SilkS" (layer "B.SilkS")
  (constraint text_height (min 1.2mm)) (constraint text_thickness (min 0.15mm)))
