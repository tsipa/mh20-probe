{
  "board": "Classic ESP32-WROOM DevKit (ESP32-DevKitC V4) / ESP32 Dev Module",
  "logic_voltage": 3.3,
  "cc1101": {
    "bus": "VSPI",
    "supply_voltage": 3.3,
    "pins": [
      {
        "pin": 1,
        "signal": "GND",
        "esp32": "GND"
      },
      {
        "pin": 2,
        "signal": "VCC",
        "esp32": "3V3"
      },
      {
        "pin": 3,
        "signal": "GDO0",
        "gpio": 26
      },
      {
        "pin": 4,
        "signal": "CSN",
        "gpio": 5
      },
      {
        "pin": 5,
        "signal": "SCK",
        "gpio": 18
      },
      {
        "pin": 6,
        "signal": "MOSI",
        "gpio": 23
      },
      {
        "pin": 7,
        "signal": "MISO/GDO1",
        "gpio": 19
      },
      {
        "pin": 8,
        "signal": "GDO2",
        "esp32": "NC"
      }
    ]
  },
  "display": {
    "driver": "ST7789-compatible, 240x240, 7-pin, no CS",
    "bus": "HSPI",
    "spi_mode": 3,
    "init_hz": 1000000,
    "draw_hz": 20000000,
    "rotation": 0,
    "pins": [
      {
        "signal": "GND",
        "esp32": "GND"
      },
      {
        "signal": "VCC",
        "esp32": "3V3"
      },
      {
        "signal": "BLK",
        "esp32": "3V3"
      },
      {
        "signal": "SCL/SCK",
        "gpio": 14
      },
      {
        "signal": "SDA/MOSI",
        "gpio": 13
      },
      {
        "signal": "RES",
        "gpio": 27
      },
      {
        "signal": "DC",
        "gpio": 32
      }
    ]
  },
  "machine_reserved": [
    {
      "gpio": 33,
      "signal": "READY",
      "high": "Validated probe, including contact",
      "driver": "R2 150 ohm -> K2 AQY212EH",
      "terminal": "J1 pins 3/4 (READY_A/READY_B)"
    },
    {
      "gpio": 25,
      "signal": "PROBE_LOOP_ENABLE",
      "high": "Validated free probe; closes normally open PhotoMOS K1",
      "driver": "R1 150 ohm -> K1 AQY212EH",
      "terminal": "J1 pins 5/6 (PROBE_A/PROBE_B)"
    }
  ],
  "supply": {
    "regulator": "U1 DD4012SA 5 V step-down module, 7805 pinout, input 4.75-40 V, not isolated",
    "nets": {
      "24V_IN": "J1.1 -> U1 IN",
      "GND": "J1.2 machine 0 V = logic GND",
      "5V_REG": "U1 OUT -> JP1",
      "5V_DEV": "JP1 -> ESP32 5V"
    },
    "peripherals": "3V3 from the ESP32 DevKit regulator",
    "isolation": "Only the two AQY212EH PhotoMOS outputs",
    "usb": "With JP1 fitted, do not connect USB to a PC while on machine 24 V; remove JP1 to power from USB on the bench"
  },
  "terminal_j1": {
    "1": "24V_IN",
    "2": "0 V (machine 0 V = logic GND)",
    "3": "READY_A",
    "4": "READY_B",
    "5": "PROBE_A",
    "6": "PROBE_B",
    "note": "PhotoMOS outputs are bidirectional; A/B polarity does not matter."
  }
}
